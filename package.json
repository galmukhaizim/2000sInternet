{
  "name": "retro-web",
  "version": "0.4.0",
  "private": true,
  "description": "Tampermonkey userscript that redesigns any website in a 2000s internet aesthetic using an in-browser small language model",
  "type": "module",
  "scripts": {
    "build": "node userscript/build.mjs",
    "watch": "node userscript/build.mjs --watch",
    "host": "node userscript/host/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node eval/run.mjs",
    "inspect-cli": "node userscript/scripts/inspect-cli.mjs",
    "validate-cli": "node userscript/scripts/validate-cli.mjs",
    "eval:mock": "node eval/run.mjs --fixtures --mock --label mock",
    "prompts-cli": "node userscript/scripts/prompts-cli.mjs"
  },
  "devDependencies": {
    "@mlc-ai/web-llm": "0.2.87",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.63.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
